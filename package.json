{
  "name": "spine-mcp-server",
  "version": "0.1.1",
  "description": "MCP tools for Spine 4.3 and 3.8 animation projects on macOS and Windows",
  "main": "dist/index.js",
  "type": "commonjs",
  "bin": {
    "spine-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/",
    "vendor/",
    "scripts/",
    "docs/",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "spine",
    "spine-3.8",
    "spine-4.3",
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "animation",
    "skeleton",
    "cocos",
    "cocos-creator",
    "game-development",
    "ai-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/int2e/spine-mcp-server-macos.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "node dist/index.js check",
    "info": "node dist/index.js info",
    "installer": "node scripts/installer.js",
    "package:ccx": "node scripts/package-ccx.js",
    "manual:html": "node scripts/gen-manual-html.js",
    "test:unit": "node --test tests/unit-tests.mjs",
    "test:all": "npm run build && npm run test:unit && node tests/run-integration.cjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:4.3": "npm run build && node --test tests/spine43-integration.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@esotericsoftware/spine-canvas": "~4.3.13",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.0.0",
    "sharp": "^0.33.0"
  },
  "optionalDependencies": {
    "canvas": "^3.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
