# macOS 默认在 /Applications 和 ~/Applications 中查找 Spine.app。
# SPINE_EXE=/Applications/Spine.app/Contents/MacOS/Spine
# macOS 默认固定 4.3.26。使用其他补丁版本时填写团队的实际版本。
# SPINE_VERSION=4.3.26
# Windows 也可指定启动器及版本，例如：
# SPINE_EXE="C:/Program Files/Spine/Spine.com"
# SPINE_VERSION=3.8.75
LOG_LEVEL=info
CLI_TIMEOUT_MS=60000
# COCOS_WORKSPACE=/path/to/project
